    {
      "name": "Bills due",
      "kind": "CRON",
      "schedule": "0 8 * * *",
      "prompt": "Check bills due in the next 3 days against what has been paid. Name each with amount and date; stay silent if nothing is due.",
      "silentIfNothing": true
    },
    {
      "name": "Subscription audit",
      "kind": "CRON",
      "schedule": "0 10 1 * *",
      "prompt": "List every recurring charge seen this month with its amount and last use; flag ones unused for 30 days and any price rise.",
      "silentIfNothing": true
    },
    {
      "name": "Spend this week",
      "kind": "CRON",
      "schedule": "0 17 * * 5",
      "prompt": "Sum this week's spending by category against the budget; one line per category that is over, and the total.",
      "silentIfNothing": true
    }
  ],
  "signals": [
    "notification.bank",
    "sms.mobile-money",
    "time.tick"
  ],
  "suggestions": {
    "maxPerWeek": 2,
    "topics": [
