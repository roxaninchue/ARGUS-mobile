  "approvals": [
    "Any booking or payment",
    "Sharing an itinerary with another person",
    "Changing or cancelling a booking"
  ],
  "routines": [
    {
      "name": "Check-in reminder",
      "kind": "EVENT",
      "schedule": "trip.checkin-open",
      "prompt": "Online check-in just opened for a booked flight. Give the airline, flight, seat state and the check-in link.",
      "silentIfNothing": true
    },
    {
      "name": "Packing day before",
      "kind": "CRON",
      "schedule": "0 18 * * *",
      "prompt": "If a trip starts tomorrow, send the packing list for its weather, length and purpose; stay silent otherwise.",
      "silentIfNothing": true
    },
    {
      "name": "Flight status watch",
      "kind": "WATCH",
      "schedule": "*/30 * * * *",
      "prompt": "On travel days only, check the booked flight's status; report a delay, gate change or cancellation at once.",
      "silentIfNothing": true
    }
  ],
  "signals": [
    "calendar.changed",
    "connector.mail.booking",
    "time.tick"
  ],
  "suggestions": {
    "maxPerWeek": 2,
    "topics": [
      "check-in open",
      "visa needed",
      "passport expiry before trip"
    ]
  }
