    "Submitting graded work (and never handing over answers to it)",
    "Enrolling in or paying for a course",
    "Messaging a teacher or classmate"
  ],
  "routines": [
    {
      "name": "Spaced repetition",
      "kind": "CRON",
      "schedule": "0 19 * * *",
      "prompt": "If flashcards are due today, say how many and the deck; offer a 10-minute session. Stay silent when none are due.",
      "silentIfNothing": true
    },
    {
      "name": "Exam countdown",
      "kind": "CRON",
      "schedule": "0 8 * * *",
      "prompt": "For each exam in the next 21 days, give days left and today's topic from the study plan.",
      "silentIfNothing": true
    }
  ],
  "signals": [
    "connector.classroom.coursework",
    "time.tick"
  ],
  "suggestions": {
    "maxPerWeek": 2,
    "topics": [
      "cards due",
      "exam soon",
      "assignment due"
    ]
  }
